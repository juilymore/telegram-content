# Telegram — from @BotFather when you created the bot
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID — from @userinfobot.
# The bot ignores every message from any other sender.
ALLOWED_TELEGRAM_USER_ID=

# Optional: also accept posts from one Telegram Channel (bot must be an
# admin there). Leave blank at first — the bot will log the channel's real
# chat id to the console the first time you post there, so you can copy it
# in. Channel posts have no sender identity, so this is checked by chat id.
ALLOWED_CHANNEL_ID=

# Gemini API key — powers everything: the gatekeeper check, drafting/revision,
# and the Google Search grounding used for news enrichment.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override — check https://aistudio.google.com/ for the current
# model list before relying on this default, model names get retired/renamed.
# GEMINI_MODEL=gemini-3.6-flash

# Supabase — Project Settings → API in your Supabase dashboard.
# Use the SERVICE ROLE key (not the anon/public key) — this runs server-side
# only (locally, and inside the Vercel function), never in a browser.
# Run supabase_schema.sql (project root) in the SQL Editor once before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the voice file location.
# VOICE_FILE_PATH=./src/meera_voice.txt
